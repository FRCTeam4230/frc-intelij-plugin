#set($requiredSubsystemsFqnArray=$requiredSubsystemsFqnCommaDelimitedString.split(","))
##The split method when called on an empty string will result in an array of one empty string token, so we need to handle that
#if($requiredSubsystemsFqnArray.size() == 1 && $requiredSubsystemsFqnArray[0] == "")
    #set($requiredSubsystemsFqnArray = [])
#end
#set($requiredSubsystemsNamesArray=$requiredSubsystemsNamesCommaDelimitedString.split(","))
