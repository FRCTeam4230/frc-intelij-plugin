        <properties/>
        <border type="none"/>
        <children>
          <grid id="de0a0" binding="templateListsOuterPanel" layout-manager="GridLayoutManager" row-count="1" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
