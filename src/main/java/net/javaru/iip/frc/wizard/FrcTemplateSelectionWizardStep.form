<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="net.javaru.iip.frc.wizard.FrcTemplateSelectionWizardStep">
  <grid id="27dc6" binding="myRootPanel" layout-manager="GridLayoutManager" row-count="2" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="f8d15" binding="templateSelectionMainPanel" layout-manager="GridLayoutManager" row-count="2" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <grid id="de0a0" binding="templateListsOuterPanel" layout-manager="GridLayoutManager" row-count="1" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
            <margin top="0" left="0" bottom="0" right="0"/>
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <tabbedpane id="87c93" class="com.intellij.ui.components.JBTabbedPane" binding="templateListsTabbedPane">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="1" use-parent-layout="false"/>
                </constraints>
                <properties/>
                <border type="etched"/>
                <children>
                  <grid id="d8ecb" binding="projectTemplatesPane" layout-manager="GridLayoutManager" row-count="2" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
                    <margin top="0" left="0" bottom="0" right="0"/>
                    <constraints>
                      <tabbedpane title-resource-bundle="i18n/FrcBundle" title-key="frc.ui.wizard.templateSelectionStep.projectTemplatesPane.title">
                        <tooltip resource-bundle="i18n/FrcBundle" key="frc.ui.wizard.templateSelectionStep.projectTemplatesPane.tooltip"/>
                      </tabbedpane>
                    </constraints>
                    <properties/>
                    <border type="none"/>
                    <children>
                      <component id="9f2fe" class="com.intellij.ui.components.JBList" binding="projectTemplatesJBList">
                        <constraints>
                          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
                        </constraints>
                        <properties/>
                      </component>
                      <hspacer id="83463">
                        <constraints>
                          <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                        </constraints>
                      </hspacer>
                      <vspacer id="b23dd">
                        <constraints>
                          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false"/>
                        </constraints>
                      </vspacer>
                    </children>
                  </grid>
                  <grid id="fb382" binding="exampleTemplatesPane" layout-manager="GridLayoutManager" row-count="2" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
                    <margin top="0" left="0" bottom="0" right="0"/>
                    <constraints>
                      <tabbedpane title-resource-bundle="i18n/FrcBundle" title-key="frc.ui.wizard.templateSelectionStep.exampleTemplatesPane.title">
                        <tooltip resource-bundle="i18n/FrcBundle" key="frc.ui.wizard.templateSelectionStep.exampleTemplatesPane.tooltip"/>
                      </tabbedpane>
                    </constraints>
                    <properties/>
                    <border type="none"/>
                    <children>
                      <component id="2f960" class="com.intellij.ui.components.JBList" binding="exampleTemplatesJBList">
                        <constraints>
                          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
                        </constraints>
                        <properties/>
                      </component>
                      <hspacer id="c8f40">
                        <constraints>
                          <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                        </constraints>
                      </hspacer>
                      <vspacer id="624ea">
                        <constraints>
                          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false"/>
                        </constraints>
                      </vspacer>
                    </children>
                  </grid>
                </children>
              </tabbedpane>
              <component id="181e9" class="com.intellij.ui.components.JBLabel">
                <constraints>
                  <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
              </component>
            </children>
          </grid>
          <component id="ff54e" class="com.intellij.ui.components.JBLabel" binding="templateDescriptionLabel">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="3" anchor="9" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
          </component>
        </children>
      </grid>
      <vspacer id="3dcb5">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false"/>
        </constraints>
      </vspacer>
    </children>
  </grid>
</form>
