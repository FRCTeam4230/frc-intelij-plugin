        <properties>
          <labelFor value="4ff4f"/>
          <text resource-bundle="i18n/FrcBundle" key="frc.ui.wizard.mws.teamNumberLabel"/>
          <toolTipText resource-bundle="i18n/FrcBundle" key="frc.ui.wizard.mws.teamNumberLabel.tooltip"/>
        </properties>
      </component>
      <component id="4ff4f" class="javax.swing.JTextField" binding="teamNumberTextField">
