<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="net.javaru.iip.frc.ui.FrcSettingsForm">
  <grid id="27dc6" binding="rootPanel" layout-manager="GridLayoutManager" row-count="2" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="f9569" layout-manager="GridLayoutManager" row-count="5" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none" title="RIO Log Output"/>
        <children>
          <component id="5b79a" class="javax.swing.JRadioButton" binding="targetWindowIsFrcToolWindowRadioButton">
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="8" fill="0" indent="2" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="&amp;FRC Tool Window"/>
              <toolTipText value="RIO Log output will appear in a dedicated FRC Tool Window" noi18n="true"/>
            </properties>
          </component>
          <component id="ccbdc" class="javax.swing.JRadioButton" binding="targetWindowIsRunWindowRadioButton">
            <constraints>
              <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="0" indent="2" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="&amp;Run Window"/>
              <toolTipText value="RIO Log output will appear as a tab in the IDEA Run tool window." noi18n="true"/>
            </properties>
          </component>
          <component id="8e982" class="javax.swing.JLabel">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="1" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Target Tool Window:"/>
            </properties>
          </component>
          <grid id="6639a" layout-manager="GridLayoutManager" row-count="1" column-count="4" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
            <margin top="0" left="0" bottom="0" right="0"/>
            <constraints>
              <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="34884" class="javax.swing.JLabel">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="1" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <labelFor value="898e"/>
                  <text value="&amp;Port:" noi18n="true"/>
                  <toolTipText value="UDP Port (0 to 65,535) of the roboRIO for logging."/>
                </properties>
              </component>
              <component id="898e" class="javax.swing.JTextField" binding="rioLogPortTextField">
                <constraints>
                  <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false">
                    <preferred-size width="50" height="-1"/>
                    <maximum-size width="100" height="-1"/>
                  </grid>
                </constraints>
                <properties>
                  <enabled value="true"/>
                  <toolTipText value="UDP Port (0 to 65,535) of the roboRIO for logging."/>
                </properties>
              </component>
              <component id="19280" class="javax.swing.JButton" binding="portToDefaultValueButton">
                <constraints>
                  <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <hideActionText value="false"/>
                  <text value="&amp;Default"/>
                  <toolTipText value="Sets the RIO Log port to its default value"/>
                </properties>
              </component>
              <hspacer id="8a359">
                <constraints>
                  <grid row="0" column="3" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
              </hspacer>
            </children>
          </grid>
          <vspacer id="80431">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false">
                <minimum-size width="-1" height="5"/>
                <preferred-size width="-1" height="5"/>
                <maximum-size width="-1" height="5"/>
              </grid>
            </constraints>
          </vspacer>
        </children>
      </grid>
      <vspacer id="29c23">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false"/>
        </constraints>
      </vspacer>
    </children>
  </grid>
  <buttonGroups>
    <group name="rioLogTargetWindowButtonGroup" bound="true">
      <member id="5b79a"/>
      <member id="ccbdc"/>
    </group>
  </buttonGroups>
</form>
