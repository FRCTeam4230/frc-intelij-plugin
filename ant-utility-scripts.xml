<project name="Utils" default="clean">
    
<!-- 
    Cleans the FRC's directory from the idea plugins-sandbox's plugin directory.
    To use, you must set the environment variable 'idea.plugins.sandbox.dir'
    to the absolute path of the plugins-sandbox directory. For example:
        C:\Users\Dilbert\.IntelliJIdea15\system\plugins-sandbox
-->    
<target name="clean">
    <property environment="env.vars" />
    <!--<echoproperties />-->
    <delete includeemptydirs="true" failonerror="false" quiet="true">
        <fileset dir="${env.vars.idea.plugins.sandbox.dir}\plugins\FRC" />
    </delete>

</target>
</project>