                    <minimum-size width="200" height="-1"/>
                  </grid>
                </constraints>
                <properties/>
                <border type="etched"/>
                <children>
                  <scrollpane id="1317d" binding="projectTemplatesScrollPane">
                    <constraints>
                      <tabbedpane title-resource-bundle="i18n/FrcBundle" title-key="frc.ui.wizard.templateSelectionStep.projectTemplatesPane.title"/>
