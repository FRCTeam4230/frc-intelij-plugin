<!-- Documentation: http://www.jetbrains.org/intellij/sdk/docs/basics/plugin_structure/plugin_configuration_file.html -->

<!-- url="" specifies the URL of the plugin homepage (displayed in the Welcome Screen and in "Plugins" settings dialog) -->
<idea-plugin url="https://gitlab.com/Javaru/frc-intellij-idea-plugin/wikis">
    
    <!-- Unique identifier of the plugin. Cannot be changed between the plugin versions. If not specified, assumed to be equal to <name>. -->
    <id>net.javaru.idea.frc</id>
    <name>FRC</name>
    <version>0.6</version>

    <!-- The vendor of the plugin.
       The optional "url" attribute specifies the URL of the vendor homepage.
       The optional "email" attribute specifies the e-mail address of the vendor.
       The optional "logo" attribute [DEPRECATED] specifies the path within the plugin JAR 
       to a 16x16 icon to be displayed next to the plugin name in the welcome screen.    -->
    <vendor url="https://gitlab.com/Javaru/frc-intellij-idea-plugin" >Javaru</vendor>
    
    <!-- please see http://www.jetbrains.org/intellij/sdk/docs/basics/getting_started/build_number_ranges.html for description -->
    <!-- Minimum ('since-build') and maximum ('until-build') build of IDEA compatible with the plugin -->
    <idea-version since-build="173.0" />

    <description><![CDATA[
        <p>
            <!-- The first sentence gets used as a summary on the plugins repository. -->
            <em><a href='http://www.firstinspires.org/'>FIRST</a> Robotics Competition</em>  
            (<a href='http://www.firstinspires.org/robotics/frc'>FRC</a>) development support for IntelliJ IDEA. 
            This plugin will work with either the free open-sourced <em>Community Edition</em> or the 
            licensed <em>Ultimate Edition</em> of IntelliJ IDEA. As of v0.6, <strong>this plugin requires 
            IntelliJ IDEA v2017.3 or later.</strong>
        </p>
        <p> </p>
        <p>
            <strong>Please report issues or make feature requests at:</strong> 
            <a href='https://gitlab.com/Javaru/frc-intellij-idea-plugin/issues'>https://gitlab.com/Javaru/frc-intellij-idea-plugin/issues</a><br>
            Usage documentation is available at the project's <a href="https://gitlab.com/Javaru/frc-intellij-idea-plugin/wikis">wiki</a>
        </p>
        <p> </p>
        <p>
            This plugin provides most of the functionality in the 'official' eclipse plugin, plus some additional functionality. 
            Although it is in beta, it was successfully used by over 300 users during 2017 FRC seasons. More features are planned 
            for future versions, with a 1.0 release coming soon. Please report issues or make feature requests via the above link.
        </p>
        
    ]]></description>

    <change-notes><![CDATA[
      <strong>v0.6.1</strong> <br>
      &nbsp;&nbsp;&bull; Resolved <a href="https://gitlab.com/Javaru/frc-intellij-idea-plugin/issues/8">Issue #8</a>, &quot;Cannot deploy code to roboRIO&quot; 
      that was caused by a change in the way the 2018 WPILib deploys code to the roboRIO<br>
      &nbsp;&nbsp;&bull; Known issue: WPI Lib changed the Net Console (i.e. RIOLog) protocol for 2018, breaking that feature. (See 
      <a href="https://gitlab.com/Javaru/frc-intellij-idea-plugin/issues/7">Issue #7</a>) I am in the process of reimplementing 
      the Net Console. I will release an update with the change soon. In the meantime, the alternate 'tailing via SSH' monitoring can be used. 
      From the menu: Tools | FRC | RIOLog Monitoring | SSH tailing<br>
      <br>
      <strong>v0.6</strong> <br>
      &nbsp;&nbsp;&bull; <strong>IntelliJ IDEA v2017.3 or later now required</strong><br>
      &nbsp;&nbsp;&bull; Added FRC project templates to IntelliJ IDEA's New Project wizard<br>
      &nbsp;&nbsp;&bull; Updates for 2018 WPILib compatibility<br>
      &nbsp;&nbsp;&bull; Improved &quot;version aware&quot; WPILib update process in the tool menu<br>
      &nbsp;&nbsp;&bull; Improvements to the <em>SSH Tailing of roboRIO Log File</em> feature<br>
      &nbsp;&nbsp;&bull; Added some words/terms to built-in spell check dictionary<br>
      &nbsp;&nbsp;&bull; Miscellaneous changes and improvements<br>
      <br>
      <strong>v0.5</strong> <br>
      &nbsp;&nbsp;&bull; Resolved <a href="https://gitlab.com/Javaru/frc-intellij-idea-plugin/issues/3">Issue #3</a> that was causing changes to plugin settings 
      to not be persisted between IDE runs when using IntelliJ IDEA v2017.1<br>
      &nbsp;&nbsp;&bull; Fixed a high CPU utilization issue with the experimental SSH tailing feature. It still may need some more tweaking to reduced CPU usage 
      for when the roboRIO is not connected and the SSH tail is testing to see if the roboRIO is connected again.<br>
      &nbsp;&nbsp;&bull; Resolved two issues related to lifecycle / &quot;initialization sequencing&quot; that caused some exceptions -- 
      &quot;Runner FrcRioLog is not registered&quot; or an &quot;IndexNotReadyException&quot; -- when opening a new FRC project.<br>
      &nbsp;&nbsp;&bull; Added some <em>initial</em> documentation on the project's 
      <a href="https://gitlab.com/Javaru/frc-intellij-idea-plugin/wikis">wiki</a><br>
      &nbsp;&nbsp;&bull; Added some words/terms to built-in spell check dictionary<br>
      <br>
      <strong>v0.4</strong> <br>
      &nbsp;&nbsp;&bull; Add tailing of roboRIO log via SSH over Wi-Fi (Experimental Feature). Like Net Console log monitoring, it supports the 
      use of the <a href='https://plugins.jetbrains.com/idea/plugin/7125-grep-console'>Grep Console plugin</a> to provide syntax highlighting and line folding<br>
      &nbsp;&nbsp;&bull; Resolved issue with RioLog console not auto clearing (on roboRIO restart) when selected due to a character encoding difference on some developers' systems<br>
      &nbsp;&nbsp;&bull; Added some words/terms to built-in spell check dictionary<br>
      <br>
      <strong>v0.3.1</strong> <br>
      &nbsp;&nbsp;&bull; Fixed an issue where the WpiLib was not downloaded to the properly nested directory. The 'current' sub-directory was missing in the full path.<br>
      <br>
      <strong>v0.3</strong> <br>
      &nbsp;&nbsp;&bull; Added auto checks at project startup that WPILib and User Lib are attached as Libraries<br>
      &nbsp;&nbsp;&bull; Auto prompt at startup if Team Number is not configured<br>
      &nbsp;&nbsp;&bull; Added notification about known issue of RioLog socket binding issue if two FRC projects are open at the same time<br>
      &nbsp;&nbsp;&bull; Updated built-in spell check dictionary with additional FRC domain specific terms/words<br>
      &nbsp;&nbsp;&bull; Some code cleanup and minor improvements<br>
      <br>
      <strong>v0.2</strong> <br>
      &nbsp;&nbsp;&bull; Downloading of the WPILib libraries (Tools > Frc > Downloading Latest WPILib)<br>
      &nbsp;&nbsp;&bull; Easy attachment of the WPILib libraries as dependencies (Tools > Frc > Attach WPILib JARs as Dependency)<br>
      &nbsp;&nbsp;&bull; Easy attachment of the User Lib directory as dependencies (Tools > Frc > Attach User Lib Directory as Dependency)<br>
      &nbsp;&nbsp;&bull; Some code cleanup and minor improvements<br>
      <br>
      <strong>v0.1</strong> <br>
      &nbsp;&nbsp;&bull; Initial beta release of plugin <br>
      &nbsp;&nbsp;&bull; FRC Facet <br>
      &nbsp;&nbsp;&bull; RioLog monitoring <br>
      &nbsp;&nbsp;&bull; Basic FRC templates <br>
      &nbsp;&nbsp;&bull; Auto discovery of FRC projects to auto add FRC Facet <br>
    ]]>
    </change-notes>

    
    <!-- please see http://www.jetbrains.org/intellij/sdk/docs/basics/getting_started/plugin_compatibility.html on how to target different products -->
    <!-- The unique identifiers of the plugins on which this plugin depends. -->
    <depends>com.intellij.modules.lang</depends>
    <depends>com.intellij.modules.java</depends>
    <!-- TODO: Make AntSupport Required ? -->
    <!--<depends>AntSupport</depends>-->

    <!-- Optional dependency on another plugin.
       If the plugin with the "MySecondPlugin" ID is installed, the contents of 
       mySecondPlugin.xml (the format of this file conforms to the format of plugin.xml) will be loaded.
    <depends optional="true" config-file="mySecondPlugin.xml">MySecondPlugin</depends>
    -->


    <!-- Allows a plugin to integrate its help system (in JavaHelp format) with the IDEA help system. 
         The "file" attribute specifies the name of the JAR file in the "help" subdirectory of the plugin 
         directory. The "path" attribute specifies the name of the helpset file within the JAR file.-->
    <!--<helpset file="myHelp.jar" path="/Help.hs" />-->


    <!-- Resource bundle from which the text of plugin descriptions, action names and etc. will be loaded -->
    <resource-bundle>messages.FrcBundle</resource-bundle>


    
    <!-- Extension points defined by the plugin. Extension points are registered by a plugin so that other plugins can 
         provide this plugin with certain data. The "beanClass" attribute specifies the class the implementations of
         which can be used for the extension point. -->
    <!-- Ref: http://www.jetbrains.org/intellij/sdk/docs/basics/plugin_structure/plugin_extensions_and_extension_points.html -->
    <extensionPoints>
        <!--<extensionPoint name="fooExtensionPoint" beanClass="com.foo.impl.FooExtensionBean" />-->
    </extensionPoints>

    
    
    
    <!-- Extensions which the plugin adds to extension points defined by the IDEA core or by other plugins.
         The "defaultExtensionNs " attribute must be set to the ID of the plugin defining the extension point, or to 
         "com.intellij" if the extension point is defined by the IDEA core. The name of the tag within the <extensions>
         tag matches the name of the extension point, and the "implementation" class specifies the name of the class
         added to the extension point. -->
    <!-- **REFERENCES** 
             General Info:              http://www.jetbrains.org/intellij/sdk/docs/basics/plugin_structure/plugin_extensions_and_extension_points.html
             Detailed attribute info:   https://sites.google.com/site/malenkov/java/150403
             To get a list of extension points available in the IntelliJ Platform core, consult the <extensionPoints> section of the following XML configuration files:
                    LangExtensionPoints.xml        https://upsource.jetbrains.com/idea-ce/file/idea-ce-c6ad05b2d01e9cd9e95f1d3eca236cc5aa62e0a4/platform/platform-resources/src/META-INF/LangExtensionPoints.xml
                    PlatformExtensionPoints.xml    https://upsource.jetbrains.com/idea-ce/file/idea-ce-c6ad05b2d01e9cd9e95f1d3eca236cc5aa62e0a4/platform/platform-resources/src/META-INF/PlatformExtensionPoints.xml
                    VcsExtensionPoints.xml         https://upsource.jetbrains.com/idea-ce/file/idea-ce-130563882ed14f7d2462b1968dab8eec93aa1262/platform/platform-resources/src/META-INF/VcsExtensionPoints.xml
             -->
    <extensions defaultExtensionNs="com.intellij">
        <facetType id="FRC_FACET" implementation="net.javaru.iip.frc.facet.FrcFacetType" />

        <executor id="FrcRioLogToolWindowExecutor" implementation="net.javaru.iip.frc.riolog.ui.FrcRioLogToolWindowExecutor" />
        
        <spellchecker.bundledDictionaryProvider implementation="net.javaru.iip.frc.spellchecker.FrcBundledDictionaryProvider" />

        <applicationService id="FRC.FrcApplicationSettings"     serviceImplementation="net.javaru.iip.frc.settings.FrcApplicationSettings" />
        <applicationService id="FRC.FrcNotificationsSettings"   serviceImplementation="net.javaru.iip.frc.settings.FrcNotificationsSettings" />
        <applicationService id="FRC.FrcRoboRioSettings"         serviceImplementation="net.javaru.iip.frc.settings.FrcRoboRioSettings" />
        <applicationService id="FRC.FrcSshSettings"             serviceImplementation="net.javaru.iip.frc.settings.FrcSshSettings" />
        
        <applicationService id="FRC.RioLogUdpSocketManagerApplicationService" serviceImplementation="net.javaru.iip.frc.riolog.udp.RioLogUdpSocketManagerApplicationService" />
        <applicationService id="FRC.TcpRioSocketConnectorApplicationService" serviceImplementation="net.javaru.iip.frc.riolog.tcp.TcpRioSocketConnectorApplicationService" />
        
        <applicationConfigurable id="FRC.FrcApplicationSettingsConfigurable" instance="net.javaru.iip.frc.settings.FrcApplicationSettingsConfigurable" groupId="language" />


        <projectService id="FRC.RioLogConsoleProjectService"
                        serviceInterface="net.javaru.iip.frc.riolog.RioLogProjectService"
                        serviceImplementation="net.javaru.iip.frc.riolog.RioLogProjectService" />

        <projectService id="FRC.TcpRioLogConsoleProjectService"
                        serviceInterface="net.javaru.iip.frc.riolog.tcp.TcpRioLogMonitorProjectService"
                        serviceImplementation="net.javaru.iip.frc.riolog.tcp.TcpRioLogMonitorProjectService" />

        <projectService id="FRC.UdpRioLogConsoleProjectService"
                        serviceInterface="net.javaru.iip.frc.riolog.udp.UdpRioLogMonitorProjectService"
                        serviceImplementation="net.javaru.iip.frc.riolog.udp.UdpRioLogMonitorProjectService" />

        <projectService id="FRC.SshRioLogConsoleProjectService"
                        serviceInterface="net.javaru.iip.frc.riolog.ssh.SshRioLogMonitorProjectService"
                        serviceImplementation="net.javaru.iip.frc.riolog.ssh.SshRioLogMonitorProjectService" />

        <fileTemplateGroup implementation="net.javaru.iip.frc.templates.FrcFileTemplateGroupDescriptorFactory" />

        <moduleType id="FrcModuleType" implementationClass="net.javaru.iip.frc.module.FrcModuleType" />
        <moduleBuilder id="FrcModuleBuilder" builderClass="net.javaru.iip.frc.module.FrcModuleBuilder" order="first" />

        
        <projectTemplate projectType="FRC_Module" templatePath="projectTemplates/robots/FRC_Command_Based_Robot.zip" />
        <projectTemplate projectType="FRC_Module" templatePath="projectTemplates/robots/FRC_Iterative_Robot.zip" />
        <projectTemplate projectType="FRC_Module" templatePath="projectTemplates/robots/FRC_Timed_Robot.zip" />
        <projectTemplate projectType="FRC_Module" templatePath="projectTemplates/robots/FRC_Sample_Robot.zip" />
        
        
        <!--<frameworkSupport implementation="net.javaru.iip.frc.facet.framework.FrcFrameworkSupportProvider" />-->
        <framework.detector implementation="net.javaru.iip.frc.facet.framework.detector.RobotSubclassFrcFrameworkDetector" />
    </extensions>

    
    
    <application-components>
