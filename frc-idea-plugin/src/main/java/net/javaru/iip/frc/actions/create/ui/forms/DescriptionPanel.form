<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="net.javaru.iip.frc.actions.create.ui.forms.DescriptionPanelBean">
  <grid id="27dc6" binding="myRootPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="65131" binding="myDescriptionPanel" layout-manager="FlowLayout" hgap="5" vgap="5" flow-align="0">
        <constraints border-constraint="North"/>
        <properties/>
        <border type="empty">
          <size top="0" left="0" bottom="0" right="0"/>
        </border>
        <children>
          <component id="80085" class="com.intellij.ui.components.JBLabel" binding="myDescriptionLabel">
            <constraints/>
            <properties>
              <font style="2"/>
            </properties>
          </component>
          <hspacer id="93241">
            <constraints/>
          </hspacer>
        </children>
      </grid>
      <grid id="c2413" binding="myContentPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
        <constraints border-constraint="Center"/>
        <properties/>
        <border type="empty"/>
        <children/>
      </grid>
    </children>
  </grid>
</form>
