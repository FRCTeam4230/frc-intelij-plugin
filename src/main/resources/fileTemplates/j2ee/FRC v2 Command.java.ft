## A hack, so we can have a hash character in JavaDocs for {@link} entries
#set( $H = '#' )
#set($requiredSubsystemsFqnArray=$requiredSubsystemsFqnCommaDelimitedString.split(","))
## The split method when called on an empty string will result in an array of one empty string token, so we need to handle that *#
#if($requiredSubsystemsFqnArray.size() == 1 && $requiredSubsystemsFqnArray[0] == "")
    #set($requiredSubsystemsFqnArray = [])
#end
#set($requiredSubsystemsNamesArray=$requiredSubsystemsNamesCommaDelimitedString.split(","))
#if($requiredSubsystemsNamesArray.size() == 1 && $requiredSubsystemsNamesArray[0] == "")
    #set($requiredSubsystemsNamesArray = [])
#end
#set($requiredSubsystemsVarsArray=$requiredSubsystemsVarsCommaDelimitedString.split(","))
#if($requiredSubsystemsVarsArray.size() == 1 && $requiredSubsystemsVarsArray[0] == "")
    #set($requiredSubsystemsVarsArray = [])
#end
#set($requiredSubsystemsSingletonCallsArray=$requiredSubsystemsSingletonCallsCommaDelimitedString.split(","))
#if($requiredSubsystemsSingletonCallsArray.size() == 1 && $requiredSubsystemsSingletonCallsArray[0] == "")
    #set($requiredSubsystemsSingletonCallsArray = [])
#end

#if(${PACKAGE_NAME})
#if (${PACKAGE_NAME} != "")
package ${PACKAGE_NAME};
#end
#end

#if($baseClassNeedsImporting == "true")
import ${baseClassFqName};
#end
#if ($needsGetRequirementsImpl == "true")
import edu.wpi.first.wpilibj2.command.Subsystem;
#end
#foreach($fqn in $requiredSubsystemsFqnArray)
import $fqn;
#end

#if ($needsGetRequirementsImpl == "true")
import java.util.Set;
#end

#parse("File Header.java")
public #if($makeAbstract == "true")abstract#end class ${NAME} ${baseClassExtendsClause}
{
#foreach($subSystemName in $requiredSubsystemsNamesArray)
    private final $subSystemName $requiredSubsystemsVarsArray[$foreach.index]#if($requiredSubsystemsSingletonCallsArray[$foreach.index] != "<NULL>") = $requiredSubsystemsSingletonCallsArray[$foreach.index]#end;
#end
#if ($needsGetRequirementsImpl == "true")
private final Set<Subsystem> subsystems;
#end

    #set($argCount = 0)
    #if($makeAbstract == "true")protected #else public #end${NAME}(#foreach($subSystemName in $requiredSubsystemsNamesArray)#if($requiredSubsystemsSingletonCallsArray[$foreach.index] == "<NULL>")#set($argCount = $argCount + 1)#if($argCount > 1), #end$subSystemName $requiredSubsystemsVarsArray[$foreach.index]#end#end)
    {
    #foreach($subSystemVar in $requiredSubsystemsVarsArray)
        #if($requiredSubsystemsSingletonCallsArray[$foreach.index] == "<NULL>")
          this.$subSystemVar = $subSystemVar;
        #end
    #end
    #if ($needsGetRequirementsImpl == "true")
        this.subsystems = Set.of(#foreach($subSystemVar in $requiredSubsystemsVarsArray)this.$subSystemVar#if($foreach.hasNext), #end#end);
    #else
        // each subsystem used by the command must be passed into the
        // addRequirements() method (which takes a vararg of Subsystem)
        addRequirements(#foreach($subSystemVar in $requiredSubsystemsVarsArray)this.$subSystemVar#if($foreach.hasNext), #end#end);
    #end
    }

#if($includeJavaDocsForOverrides == "true")
    /**
    * The initial subroutine of a command.  Called once when the command is initially scheduled.
    */
#end
    @Override
    public void initialize()
    {
        
    }

#if($includeJavaDocsForOverrides == "true")
    /**
     * The main body of a command.  Called repeatedly while the command is scheduled.
     * (That is, it is called repeatedly until {@link ${H}isFinished()}) returns true.)
     */
#end
    @Override
    public void execute()
    {
        
    }
    
#if($includeJavaDocsForOverrides == "true")
    /**
     * <p>
     * Returns whether this command has finished. Once a command finishes -- indicated by
     * this method returning true -- the scheduler will call its {@link ${H}end(boolean)} method.
     * </p><p>
     * Returning false will result in the command never ending automatically. It may still be
     * cancelled manually or interrupted by another command. Hard coding this command to always
     * return true will result in the command executing once and finishing immediately. It is 
     * recommended to use * {@link edu.wpi.first.wpilibj2.command.InstantCommand InstantCommand}
     * for such an operation.
     * </p>
     *
     * @return whether this command has finished.
     *
     */
#end
    @Override
    public boolean isFinished()
    {
        // TODO: Make this return true when this Command no longer needs to run execute()
        return false;
    }

#if($includeJavaDocsForOverrides == "true")
    /**
     * The action to take when the command ends. Called when either the command 
     * finishes normally -- that is it is called when {@link ${H}isFinished()} returns 
     * true -- or when  it is interrupted/canceled. This is where you may want to 
     * wrap up loose ends, like shutting off a motor that was being used in the command.
     * 
     * @param interrupted whether the command was interrupted/canceled
     */
#end
    @Override
    public void end(boolean interrupted)
    {
        
    }
#if ($needsGetRequirementsImpl == "true")

#if($includeJavaDocsForOverrides == "true")
    /**
     * <p>
     * Specifies the set of subsystems used by this command.  Two commands cannot use the same
     * subsystem at the same time.  If the command is scheduled as interruptible and another
     * command is scheduled that shares a requirement, the command will be interrupted.  Else,
     * the command will not be scheduled. If no subsystems are required, return an empty set.
     * </p><p>
     * Note: it is recommended that user implementations contain the requirements as a field,
     * and return that field here, rather than allocating a new set every time this is called.
     * </p>
     * 
     * @return the set of subsystems that are required
     */
#end
    @Override
    public Set<Subsystem> getRequirements()
    {
        return this.subsystems;
    }
#end
}
