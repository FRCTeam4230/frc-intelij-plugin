<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="net.javaru.iip.frc.ui.FrcSettingsForm">
  <grid id="27dc6" binding="rootPanel" layout-manager="GridLayoutManager" row-count="2" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="f9569" layout-manager="GridLayoutManager" row-count="2" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none" title="RIO Log Output Target Window"/>
        <children>
          <component id="5b79a" class="javax.swing.JRadioButton" binding="targetWindowIsFrcToolWindowRadioButton">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="8" fill="0" indent="1" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="FRC Tool Window"/>
              <toolTipText value="RIO Log output qill appear in a dedicated FRC Tool Window" noi18n="true"/>
            </properties>
          </component>
          <component id="ccbdc" class="javax.swing.JRadioButton" binding="targetWindowIsRunWindowRadioButton">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="0" indent="1" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Run Window"/>
              <toolTipText value="RIO LOg output will appear as a tab in the IDEA Run tool window." noi18n="true"/>
            </properties>
          </component>
        </children>
      </grid>
      <vspacer id="29c23">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false"/>
        </constraints>
      </vspacer>
    </children>
  </grid>
  <buttonGroups>
    <group name="rioLogTargetWindowButtonGroup" bound="true">
      <member id="5b79a"/>
      <member id="ccbdc"/>
    </group>
  </buttonGroups>
</form>
