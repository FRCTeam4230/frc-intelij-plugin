#if($makeSingleton == "true")

#if($singletonIncludeJavadoc == "true")
/**
 * Returns the Singleton instance of this ${NAME}. This static method 
 * should be used, rather than the constructor, to get the single instance
 * of this class. For example: {@code ${NAME}.getInstance();}
 */
@SuppressWarnings("WeakerAccess")
#end
public static ${NAME} getInstance()
{    
#if($singletonInitMethodology == "EAGER")
    return INSTANCE;
#elseif($singletonInitMethodology == "THREAD_SAFE")
    // Use "Double Checked Locking" to ensure thread safety and best performance
    // Fast (non-synchronized) check to reduce overhead of acquiring a lock when it's not needed
    if (INSTANCE == null)
    {
        // Lock to make thread safe 
        synchronized (${NAME}.class)
        {
            // check nullness again as multiple threads can reach and
            // pass the initial non-synchronized null check above
            if(INSTANCE==null)
            {
                INSTANCE = new ${NAME}();
            }
        }
    }    
    return INSTANCE; 
#else ## LAZY
    if (INSTANCE == null)
    {
        INSTANCE = new ${NAME}();
    }
    return INSTANCE;
#end
}

#end
