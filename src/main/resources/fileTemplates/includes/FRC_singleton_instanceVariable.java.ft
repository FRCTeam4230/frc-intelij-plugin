#set( $H = '#' )
#if($makeSingleton == "true")
#if($singletonInitMethodology == "EAGER")
    
    // With eager singleton initialization, any static variables/fields used in the 
    // constructor must appear before the "INSTANCE" variable so that they are initialized 
    // before the constructor is called when the "INSTANCE" variable initializes.
    
#end
#if($singletonIncludeJavadoc == "true") 
/**
 * The Singleton instance of this ${NAME}. External classes should
 * use the {@link ${H}getInstance()} method to get the instance.
 */
#end
#if($singletonInitMethodology == "EAGER")
private final static ${NAME} INSTANCE = new ${NAME}();
#else
private static ${NAME} INSTANCE;     
#end
#end
