<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="net.javaru.iip.frc.wizard.KotlinDslUseAcknowledgementDialogWrapper">
  <grid id="27dc6" binding="mainPanel" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="545" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="90dfa" binding="wrappingDisclaimerPanel" layout-manager="GridLayoutManager" row-count="4" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="4" left="8" bottom="4" right="8"/>
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="9" fill="0" indent="0" use-parent-layout="false">
            <preferred-size width="500" height="-1"/>
            <maximum-size width="600" height="600"/>
          </grid>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="780ea" class="com.intellij.ui.components.JBLabel" binding="disclaimerLabel">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text resource-bundle="i18n/FrcBundle" key="frc.ui.wizard.projectSettingsStep.kotlinDsl.disclaimer.text"/>
            </properties>
          </component>
          <vspacer id="81b7e">
            <constraints>
              <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false"/>
            </constraints>
          </vspacer>
          <grid id="15c20" binding="acknowledgmentPreamblePanel" layout-manager="GridLayoutManager" row-count="3" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
            <margin top="20" left="0" bottom="10" right="0"/>
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="6bee6" class="com.intellij.ui.components.JBLabel">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text resource-bundle="i18n/FrcBundle" key="frc.ui.wizard.projectSettingsStep.kotlinDsl.disclaimerMessageDialog.acknowledgementPreamble.line1"/>
                </properties>
              </component>
              <vspacer id="3066c">
                <constraints>
                  <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false"/>
                </constraints>
              </vspacer>
              <component id="551a4" class="com.intellij.ui.components.JBLabel">
                <constraints>
                  <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text resource-bundle="i18n/FrcBundle" key="frc.ui.wizard.projectSettingsStep.kotlinDsl.disclaimerMessageDialog.acknowledgementPreamble.line2"/>
                </properties>
              </component>
            </children>
          </grid>
          <component id="eeab2" class="com.intellij.ui.components.JBCheckBox" binding="acknowledgeCheckbox">
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="8" fill="0" indent="2" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text resource-bundle="i18n/FrcBundle" key="frc.ui.common.acknowledged"/>
            </properties>
          </component>
        </children>
      </grid>
    </children>
  </grid>
</form>
