<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="net.javaru.iip.frc.wizard.TeamNumberDialogWrapper">
  <grid id="27dc6" binding="mainPanel" layout-manager="GridLayoutManager" row-count="5" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="596" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="54f0d" class="com.intellij.ui.components.JBLabel" binding="introductionLabel">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text resource-bundle="i18n/FrcBundle" key="frc.ui.wizard.teamNumberDialogWrapper.intro.label.text"/>
        </properties>
      </component>
      <hspacer id="89e04">
        <constraints>
          <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
      </hspacer>
      <vspacer id="4411e">
        <constraints>
          <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false"/>
        </constraints>
      </vspacer>
      <component id="8baca" class="com.intellij.ui.components.JBRadioButton" binding="actualNumberRadioButton">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="0" indent="2" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text resource-bundle="i18n/FrcBundle" key="frc.ui.wizard.teamNumberDialogWrapper.radioButton.actualNumber.text"/>
        </properties>
      </component>
      <component id="73fe9" class="com.intellij.ui.components.JBRadioButton" binding="variantNumberRadioButton">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="0" indent="2" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text resource-bundle="i18n/FrcBundle" key="frc.ui.wizard.teamNumberDialogWrapper.radioButton.variant.text"/>
        </properties>
      </component>
      <component id="ef92d" class="com.intellij.ui.components.JBTextField" binding="teamNumberInputTextField">
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="4" use-parent-layout="false">
            <minimum-size width="200" height="-1"/>
            <preferred-size width="200" height="-1"/>
            <maximum-size width="200" height="-1"/>
          </grid>
        </constraints>
        <properties/>
      </component>
    </children>
  </grid>
  <buttonGroups>
    <group name="teamNumberButtonGroup">
      <member id="8baca"/>
      <member id="73fe9"/>
    </group>
  </buttonGroups>
</form>
