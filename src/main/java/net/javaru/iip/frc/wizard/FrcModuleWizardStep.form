        </constraints>
        <properties>
          <toolTipText resource-bundle="i18n/FrcBundle" key="frc.ui.wizard.mws.teamNumberLabel.tooltip"/>
        </properties>
      </component>
      <grid id="a0a23" binding="robotTemplatePanel" layout-manager="CardLayout" hgap="0" vgap="0">
