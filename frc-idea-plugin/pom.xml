<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>net.javaru.intellij-idea-plugins.frc</groupId>
        <artifactId>frc-intellij-idea-plugin-parent</artifactId>
        <version>2017.0.1-SNAPSHOT</version>
        <relativePath>../</relativePath>
    </parent>

    <!--  Change assembly.xml file <includes> if you change the artifact coordinates -->
    <name>FRC IntelliJ IDEA PlugIn</name>
    <artifactId>frc-intellij-idea-plugin</artifactId>
    <packaging>jar</packaging>



    <description>
        An IntelliJ IDEA plug-in for the US First (http://www.usfirst.org) First Robotics Competition (FRC).
        It is provided as an alternative to using the default Eclipse plug-in and programming environment.
    </description>

    <organization>
        <name>Javaru</name>
    </organization>

    <licenses>
        <license>
            <name>The Apache Software License, Version 2.0</name>
            <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <!-- TODO: Update to website once created -->
    <url>https://gitlab.com/Javaru/frc-intellij-idea</url>

    <scm>
        <url>https://gitlab.com/Javaru/frc-intellij-idea</url>
        <connection>scm:git:git@gitlab.com:Javaru/frc-intellij-idea</connection>
        <!--suppress MavenModelInspection -->
        <developerConnection>scm:git:ssh://git@gitlab.com:Javaru/frc-intellij-idea</developerConnection>
    </scm>

    <!--<ciManagement></ciManagement>-->

    <issueManagement>
        <system>GitLab</system>
        <url>https://gitlab.com/Javaru/frc-intellij-idea/issues</url>
    </issueManagement>


    <dependencies>
        <!-- region INTELLIJ IDEA -->
        <dependency>
            <groupId>com.intellij.idea</groupId>
            <artifactId>annotations</artifactId>
        </dependency>
        <dependency>
            <groupId>com.intellij.idea</groupId>
            <artifactId>extensions</artifactId>
        </dependency>
        <dependency>
            <groupId>com.intellij.idea</groupId>
            <artifactId>resources</artifactId>
        </dependency>
        <dependency>
            <groupId>com.intellij.idea</groupId>
            <artifactId>resources_en</artifactId>
        </dependency>
        <dependency>
            <groupId>com.intellij.idea</groupId>
            <artifactId>idea</artifactId>
        </dependency>
        <dependency>
            <groupId>com.intellij.idea</groupId>
            <artifactId>openapi</artifactId>
        </dependency>
        <dependency>
            <groupId>com.intellij.idea</groupId>
            <artifactId>forms_rt</artifactId>
        </dependency>
        <dependency>
            <groupId>com.intellij.idea</groupId>
            <artifactId>icons</artifactId>
        </dependency>
        <dependency>
            <groupId>com.intellij.idea</groupId>
            <artifactId>util</artifactId>
        </dependency>
        <dependency>
            <groupId>com.intellij.idea</groupId>
            <artifactId>groovy-plugin</artifactId>
        </dependency>
        <!-- endregion IntelliJ IDEA -->

        
        
    </dependencies>


        <build>
        <plugins>
            <plugin>
                <artifactId>maven-assembly-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <configuration>
                            <descriptors>
                                <descriptor>assembly.xml</descriptor>
                            </descriptors>
                            <attach>true</attach>
                            <outputDirectory>${project.basedir}/../</outputDirectory>
                        </configuration>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>process-classes</phase>
                        <configuration>
                            <tasks>
                                <path id="compile.classpath">
                                    <fileset dir="${idea.home}/lib" includes="*.jar" />
                                    <fileset dir="${idea.home}/plugins/Groovy/lib" includes="*.jar" />
                                </path>

                                <taskdef name="javac2" classname="com.intellij.ant.Javac2" classpathref="compile.classpath" />

                                <javac2 srcdir="${project.build.sourceDirectory}" destdir="${project.build.outputDirectory}" source="1.5" target="1.5" includes="**/*.form" classpathref="compile.classpath" />
                            </tasks>
                        </configuration>
                        <goals>
                            <goal>run</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>


</project>
