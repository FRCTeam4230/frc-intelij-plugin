            <action id="frc.tools.DownloadWpiLibAction"
                    text="Download Latest WPILib"
                    description="Downloads the latest WPILib files to the default user directory location, overwriting any existing version. (Requires Internet connectivity.)"
                    class="net.javaru.iip.frc.actions.tools.DownloadWpiLibAction"
                     />
            
            <add-to-group group-id="ToolsMenu" relative-to-action="IdeScriptingConsole" anchor="after" />
        </group>

        <group id="FRC.FrcRioLogActionsGroup"
               text="RIOLog Monitoring"
               class="net.javaru.iip.frc.actions.tools.riolog.FrcRioLogActionGroup"
               popup="true"
               icon="/icons/riolog/riolog.png"
               >

            <action id="frc.tools.ShowTcp"
                    text="Net Console"
                    class="net.javaru.iip.frc.actions.tools.ShowRioLogTcpConsoleAction" />
            
            <action id="frc.tools.ShowSsh"
                    text="SSH tailing (alternative RIOLog monitoring technique)"
                    class="net.javaru.iip.frc.actions.tools.ShowRioLogSshConsoleAction" />
            
            <action id="frc.tools.ShowUdp"
                    text="Legacy Net Console (2017 and older)"
                    class="net.javaru.iip.frc.actions.tools.ShowRioLogUdpConsoleAction" />
            <add-to-group group-id="FRC.FrcToolsActionsGroup" anchor="first" />
        </group>
        
        <group id="frc.NewFileTemplates"
               text="FRC"
               description="Create New FRC Components"
               class="net.javaru.iip.frc.actions.create.FrcCreateComponentsActionGroup"
               popup="true"
               icon="/icons/first/FIRST_icon_16x16.png"
        >
            <separator />
            <action id="frc.action.new.basic.command" class="net.javaru.iip.frc.actions.create.basic.NewFrcBasicCommandClassAction" text="FRC Command" />
            <action id="frc.action.new.basic.commandGroup"
                    class="net.javaru.iip.frc.actions.create.basic.NewFrcBasicCommandGroupClassAction"
                    text="FRC Command Group" />
            <action id="frc.action.new.basic.subsystem" class="net.javaru.iip.frc.actions.create.basic.NewFrcBasicSubsystemClassAction" text="FRC Subsystem" />
            <action id="frc.action.new.basic.pidSubsystem"
                    class="net.javaru.iip.frc.actions.create.basic.NewFrcBasicPidSubsystemClassAction"
                    text="FRC PID Subsystem" />
            <action id="frc.action.new.basic.trigger"
                    class="net.javaru.iip.frc.actions.create.basic.NewFrcBasicTriggerClassAction"
                    text="FRC Trigger (i.e. Button)" />

            <!--<action id="frc.action.new.build.file" class="net.javaru.iip.frc.actions.create.build.NewFrcAntBuildFileAction" text="FRC New Ant Build File" />-->
            <add-to-group group-id="NewGroup" anchor="after" relative-to-action="NewJavaSpecialFile" />
        </group>

        <action id="FRC.ConfigureTeamNumberAction"
                class="net.javaru.iip.frc.actions.ConfigureTeamNumberBasicAction"
                text="Configure FRC Team Number"
                icon="/icons/first/FIRST_icon_16x16.png">
            <add-to-group group-id="ToolsMenu" relative-to-action="IdeScriptingConsole" anchor="after" />
            <add-to-group group-id="WelcomeScreen.Configure" />
        </action> 
        
        <action id="FRC.ConfigureTeamNumberAction.Quickstart"
                class="net.javaru.iip.frc.actions.ConfigureTeamNumberStatusAwareAction"
                text="Configure FRC Team Number"
                icon="/icons/first/FIRST_icon_16x16.png"
                description="Quickstart Action to set FRC Team Number">
            <add-to-group group-id="ToolsMenu" relative-to-action="IdeScriptingConsole" anchor="after" />
            <add-to-group group-id="WelcomeScreen.QuickStart" />
        </action>
        
    </actions>

</idea-plugin>