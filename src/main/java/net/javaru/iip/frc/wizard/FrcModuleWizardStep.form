        </constraints>
        <properties/>
        <border type="none" title-resource-bundle="i18n/FrcBundle" title-key="frc.ui.wizard.mws.projectTemplateSelectionPanel.title"/>
        <children>
          <component id="2affd" class="com.intellij.ui.components.JBList" binding="projectTemplatesJBList">
